# Synthetic local configuration. Supply fresh values yourself; never commit .env.
APP_ENV=local
API_HOST=127.0.0.1
DATABASE_URL=sqlite:///./saas.db
JWT_SECRET=
STRIPE_WEBHOOK_SECRET=
CIRCLE_API_KEY=
